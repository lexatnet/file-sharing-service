# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=test
POSTGRES_HOST=backend-db
# Postgres inside the container listens on 5432; the host port 5433 is mapped
# to it in docker-compose.dev.yml.
PGPORT=5432

# Celery / Redis
CELERY_BROKER_URL=redis://backend-redis:6379/0

# File storage — S3 (MinIO). Uploaded files live in the bucket, not on a
# local volume.
# Internal endpoint (compose network) for backend/worker S3 operations.
S3_ENDPOINT_URL=http://s3:9000
# Public endpoint embedded into presigned URLs handed to the browser
# (localhost:9000 is the compose host-port mapping of the s3 service).
S3_PUBLIC_ENDPOINT=http://localhost:9000
# Default multipart chunk size.
S3_PART_SIZE=8388608

MINIO_ROOT_USER=s3_root
MINIO_ROOT_PASSWORD=s3_root_pass
SERVICE_S3_FILES_REGION=ru-1
SERVICE_S3_FILES_BUCKET=test-bucket
SERVICE_S3_FILES_CLIENT_ID=31CSPZPH0Y7NMKUTNKSB
SERVICE_S3_FILES_CLIENT_SECRET=piB8ei2p2YF8GmFf6Rc9j1PLOZAFjGvDlUW0jAYV
