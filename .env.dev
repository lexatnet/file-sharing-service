# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=test
POSTGRES_HOST=backend-db
# Postgres inside the container listens on 5432; the host port 5433 is mapped
# to it in docker-compose.dev.yml.
PGPORT=5432

# Celery / Redis
CELERY_BROKER_URL=redis://backend-redis:6379/0

# File storage — mounted as a named volume in docker-compose, NOT on the
# host code directory.
STORAGE_DIR=/data/files
